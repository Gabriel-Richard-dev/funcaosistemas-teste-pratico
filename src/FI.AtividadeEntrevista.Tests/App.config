<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Banco EXCLUSIVO dos testes de integracao: |DataDirectory| aponta para uma pasta temporaria
      onde e colocada uma copia do BancoDeDados.mdf da aplicacao (ver Infra\BancoDeTestes.cs).
      O banco da aplicacao (App_Data) nunca e alterado pelos testes.
    -->
    <add name="BancoDeDados" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\BancoDeDados.mdf;Initial Catalog=FI_AtividadeEntrevista_Testes;Integrated Security=True" />
  </connectionStrings>
</configuration>
